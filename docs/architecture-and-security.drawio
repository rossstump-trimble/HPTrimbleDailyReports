<mxfile host="app.diagrams.net" modified="2026-09-23T18:00:00.000Z" agent="Cursor Assistant" version="24.0.0"><diagram id="system-architecture" name="1. System Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p1_title" value="&lt;b style='font-size:18px;'&gt;Hensel Phelps &amp;amp; Trimble Field Operations Prototype&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569;'&gt;High-Level System Architecture &amp;amp; Component Topology (hp-trimble-lab.com)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="200" y="20" width="800" height="45" /></mxCell><mxCell id="tier1_box" value="1. Field &amp;amp; Office Clients" style="swimlane;startSize=28;rounded=1;fontStyle=1;fontSize=13;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;align=left;spacingLeft=10;arcSize=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="80" width="1080" height="140" /></mxCell><mxCell id="subcontractor" value="&lt;b&gt;Trade Partner / Subcontractor&lt;/b&gt;&lt;br/&gt;• Mobile Web (Smartphone / Tablet)&lt;br/&gt;• Physical Jobsite QR Code Access&lt;br/&gt;• Zero Login Required (Scoped Intake)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontColor=#0369A1;fontSize=11;align=center;" vertex="1" parent="tier1_box"><mxGeometry as="geometry" x="60" y="45" width="380" height="75" /></mxCell><mxCell id="hp_staff" value="&lt;b&gt;Hensel Phelps Project Staff&lt;/b&gt;&lt;br/&gt;• Superintendent, Project Engineer, PM&lt;br/&gt;• Web App on Laptop / Tablet&lt;br/&gt;• Corporate Single Sign-On (TID SSO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=2;fontColor=#3730A3;fontSize=11;align=center;" vertex="1" parent="tier1_box"><mxGeometry as="geometry" x="640" y="45" width="380" height="75" /></mxCell><mxCell id="tier2_box" value="2. Edge &amp;amp; Ingress Tier (hp-trimble-lab.com)" style="swimlane;startSize=28;rounded=1;fontStyle=1;fontSize=13;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#78350F;align=left;spacingLeft=10;arcSize=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="250" width="1080" height="120" /></mxCell><mxCell id="edge_gw" value="&lt;b&gt;Reverse Proxy &amp;amp; Gateway (Caddy / Cloud VM Ingress)&lt;/b&gt;&lt;br/&gt;• Automated TLS 1.3 / HTTPS Termination with Strict Transport Security (HSTS)&lt;br/&gt;• Multi-Tier IP Rate Limiting (30 req/min Auth | 60 req/min Intake | 180 req/min General)&lt;br/&gt;• Security Headers: X-Content-Type-Options: nosniff | X-Frame-Options: SAMEORIGIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;fontSize=11;align=center;" vertex="1" parent="tier2_box"><mxGeometry as="geometry" x="80" y="42" width="920" height="65" /></mxCell><mxCell id="tier3_box" value="3. Application Tier (Next.js 14 Core)" style="swimlane;startSize=28;rounded=1;fontStyle=1;fontSize=13;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;align=left;spacingLeft=10;arcSize=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="400" width="1080" height="160" /></mxCell><mxCell id="app_core" value="&lt;b&gt;HP Field Prototype Application (Next.js 14 App Router)&lt;/b&gt;&lt;br/&gt;• Route &amp;amp; Auth Middleware (TID Session Verification &amp;amp; Public Intake Bypasses)&lt;br/&gt;• Subcontractor Daily Hours &amp;amp; Manpower Intake Services&lt;br/&gt;• Inspection Checklist &amp;amp; Punch List OCR Extraction Pipelines&lt;br/&gt;• Superdaily Consolidated Review &amp;amp; Staged Approval Matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=11;align=center;" vertex="1" parent="tier3_box"><mxGeometry as="geometry" x="60" y="45" width="600" height="95" /></mxCell><mxCell id="stage_cache" value="&lt;b&gt;Operational Staging Store&lt;/b&gt;&lt;br/&gt;• Ephemeral Intake Cache&lt;br/&gt;• Draft OCR Extractions&lt;br/&gt;• Pre-Commit Pending State" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontColor=#374151;fontSize=11;align=center;" vertex="1" parent="tier3_box"><mxGeometry as="geometry" x="780" y="45" width="240" height="95" /></mxCell><mxCell id="tier4_box" value="4. Enterprise Integrations &amp;amp; Intelligence Tier" style="swimlane;startSize=28;rounded=1;fontStyle=1;fontSize=13;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;align=left;spacingLeft=10;arcSize=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="590" width="1080" height="170" /></mxCell><mxCell id="tid" value="&lt;b&gt;Trimble Identity (TID)&lt;/b&gt;&lt;br/&gt;• Enterprise OIDC / OAuth 2.0&lt;br/&gt;• HP Federated Single Sign-On&lt;br/&gt;• MFA Policy Enforcement&lt;br/&gt;• Secure Session Cookies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=center;" vertex="1" parent="tier4_box"><mxGeometry as="geometry" x="40" y="45" width="290" height="105" /></mxCell><mxCell id="taai" value="&lt;b&gt;Trimble AI (TAAI) Platform&lt;/b&gt;&lt;br/&gt;• Multimodal Document OCR (Checklists &amp;amp; Punch)&lt;br/&gt;• Field Voice Note Speech-to-Text &amp;amp; Synthesis&lt;br/&gt;• &lt;b&gt;Zero Model Training Guarantee&lt;/b&gt;&lt;br/&gt;• Ephemeral Processing &amp;amp; SOC 2 Boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#15803D;fontSize=11;align=center;" vertex="1" parent="tier4_box"><mxGeometry as="geometry" x="390" y="45" width="320" height="105" /></mxCell><mxCell id="ps_api" value="&lt;b&gt;Trimble ProjectSight API&lt;/b&gt;&lt;br/&gt;• Official Corporate System of Record (SoR)&lt;br/&gt;• Daily Reports &amp;amp; Labor Logs&lt;br/&gt;• Checklists (Table 189) &amp;amp; Punch Items&lt;br/&gt;• Trade Partner Directories" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#0284C7;strokeWidth=2;fontColor=#0369A1;fontSize=11;align=center;" vertex="1" parent="tier4_box"><mxGeometry as="geometry" x="750" y="45" width="290" height="105" /></mxCell><mxCell id="e1" value="HTTPS / Scoped QR Token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0284C7;fontColor=#0369A1;fontSize=11;" edge="1" parent="1" source="subcontractor" target="edge_gw"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="HTTPS / Corporate SSO Session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4338CA;fontColor=#3730A3;fontSize=11;" edge="1" parent="1" source="hp_staff" target="edge_gw"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="Reverse Proxied HTTPS Traffic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#D97706;fontColor=#92400E;fontSize=11;" edge="1" parent="1" source="edge_gw" target="app_core"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="Transient Cache" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6B7280;fontColor=#374151;fontSize=10;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="app_core" target="stage_cache"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="1. Validate SSO Session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;fontColor=#1E293B;fontSize=11;" edge="1" parent="1" source="app_core" target="tid"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="2. Secure Multimodal OCR / Audio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;fontColor=#15803D;fontSize=11;" edge="1" parent="1" source="app_core" target="taai"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="3. Commit Approved Records (SoR)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0284C7;fontColor=#0369A1;fontSize=11;" edge="1" parent="1" source="app_core" target="ps_api"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="security-boundaries" name="2. Security &amp; Trust Boundaries"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p2_title" value="&lt;b style='font-size:18px;'&gt;Hensel Phelps &amp;amp; Trimble Field Operations Prototype&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569;'&gt;Security Zones, Access Controls &amp;amp; Trust Boundaries&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="20" width="800" height="45" /></mxCell><mxCell id="zone1_box" value="Zone 1: Unauthenticated Field Zone" style="swimlane;startSize=28;rounded=1;fontStyle=1;fontSize=12;fillColor=#F0FDF4;strokeColor=#22C55E;fontColor=#15803D;align=left;spacingLeft=10;arcSize=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="80" width="260" height="520" /></mxCell><mxCell id="z1_actor" value="&lt;b&gt;Trade Subcontractor&lt;/b&gt;&lt;br/&gt;(Field Mobile Device)&lt;br/&gt;&lt;span style='color:#15803D;'&gt;On-Site Foremen &amp;amp; Crews&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#166534;fontSize=11;align=center;" vertex="1" parent="zone1_box"><mxGeometry as="geometry" x="20" y="45" width="220" height="65" /></mxCell><mxCell id="z1_rules" value="&lt;b&gt;Zone 1 Security Controls:&lt;/b&gt;&lt;br/&gt;• Scoped to &lt;code&gt;/intake/*&lt;/code&gt; only&lt;br/&gt;• Write-only daily labor &amp;amp; notes&lt;br/&gt;• &lt;b&gt;Zero access&lt;/b&gt; to peer trades&lt;br/&gt;• &lt;b&gt;Zero access&lt;/b&gt; to budgets / schedules&lt;br/&gt;• Rate limit: 60 req/min per IP&lt;br/&gt;• No credentials to manage / leak&lt;br/&gt;• Instant field adoption via QR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1;fontColor=#14532D;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="zone1_box"><mxGeometry as="geometry" x="20" y="130" width="220" height="170" /></mxCell><mxCell id="z1_risk" value="&lt;b&gt;Risk Mitigations:&lt;/b&gt;&lt;br/&gt;• Input sanitization &amp;amp; size limits&lt;br/&gt;• Rate limiting stops spam / flood&lt;br/&gt;• Submissions isolated per trade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#F87171;strokeWidth=1;fontColor=#991B1B;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="zone1_box"><mxGeometry as="geometry" x="20" y="320" width="220" height="170" /></mxCell><mxCell id="zone2_box" value="Zone 2: Authenticated Staff Zone" style="swimlane;startSize=28;rounded=1;fontStyle=1;fontSize=12;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;align=left;spacingLeft=10;arcSize=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="80" width="260" height="520" /></mxCell><mxCell id="z2_actor" value="&lt;b&gt;Hensel Phelps Project Staff&lt;/b&gt;&lt;br/&gt;(Superintendents, PEs, PMs)&lt;br/&gt;&lt;span style='color:#1D4ED8;'&gt;Corporate Users&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=11;align=center;" vertex="1" parent="zone2_box"><mxGeometry as="geometry" x="20" y="45" width="220" height="65" /></mxCell><mxCell id="z2_rules" value="&lt;b&gt;Zone 2 Security Controls:&lt;/b&gt;&lt;br/&gt;• Full administrative access&lt;br/&gt;• Enforced Trimble Identity (TID)&lt;br/&gt;• Corporate Federated SSO &amp;amp; MFA&lt;br/&gt;• Encrypted HttpOnly session cookies&lt;br/&gt;• SameSite strict domain binding&lt;br/&gt;• Rate limit: 30 req/min (Auth)&lt;br/&gt;• Superdaily review &amp;amp; approval gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="zone2_box"><mxGeometry as="geometry" x="20" y="130" width="220" height="170" /></mxCell><mxCell id="z2_risk" value="&lt;b&gt;Risk Mitigations:&lt;/b&gt;&lt;br/&gt;• Unauthenticated redirected to SSO&lt;br/&gt;• Inactive sessions auto-expire&lt;br/&gt;• Least-privilege role boundaries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=1;fontColor=#14532D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="zone2_box"><mxGeometry as="geometry" x="20" y="320" width="220" height="170" /></mxCell><mxCell id="zone3_box" value="Zone 3: Application DMZ (hp-trimble-lab.com)" style="swimlane;startSize=28;rounded=1;fontStyle=1;fontSize=12;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#78350F;align=left;spacingLeft=10;arcSize=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="620" y="80" width="310" height="520" /></mxCell><mxCell id="z3_gw" value="&lt;b&gt;Edge Gateway &amp;amp; Reverse Proxy&lt;/b&gt;&lt;br/&gt;• TLS 1.3 Termination &amp;amp; HSTS&lt;br/&gt;• Ingress DDoS &amp;amp; Rate Limiting Filters&lt;br/&gt;• Security Headers (nosniff, SAMEORIGIN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;fontSize=11;align=center;" vertex="1" parent="zone3_box"><mxGeometry as="geometry" x="20" y="45" width="270" height="65" /></mxCell><mxCell id="z3_mw" value="&lt;b&gt;Route &amp;amp; Security Middleware&lt;/b&gt;&lt;br/&gt;• Session token inspection&lt;br/&gt;• Public intake path routing&lt;br/&gt;• CORS &amp;amp; Permissions Policies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;strokeWidth=1;fontColor=#78350F;fontSize=11;align=center;" vertex="1" parent="zone3_box"><mxGeometry as="geometry" x="20" y="130" width="270" height="60" /></mxCell><mxCell id="z3_core" value="&lt;b&gt;Next.js 14 Application Services&lt;/b&gt;&lt;br/&gt;• Daily intake submission handler&lt;br/&gt;• Inspection &amp;amp; punch verification logic&lt;br/&gt;• Pre-commit human verification drawer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=11;align=center;" vertex="1" parent="zone3_box"><mxGeometry as="geometry" x="20" y="210" width="270" height="75" /></mxCell><mxCell id="z3_cache" value="&lt;b&gt;Staging Cache (Ephemeral / Isolated)&lt;/b&gt;&lt;br/&gt;• AES-256 encrypted at rest&lt;br/&gt;• Transient storage for draft OCR/logs&lt;br/&gt;• Discarded once synced to ProjectSight" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=1;fontColor=#374151;fontSize=10;align=center;" vertex="1" parent="zone3_box"><mxGeometry as="geometry" x="40" y="320" width="230" height="80" /></mxCell><mxCell id="zone4_box" value="Zone 4: Enterprise Services &amp;amp; TAAI Boundary" style="swimlane;startSize=28;rounded=1;fontStyle=1;fontSize=12;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;align=left;spacingLeft=10;arcSize=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="960" y="80" width="280" height="520" /></mxCell><mxCell id="z4_tid" value="&lt;b&gt;Trimble Identity (TID)&lt;/b&gt;&lt;br/&gt;• Enterprise OIDC Provider&lt;br/&gt;• Token validation &amp;amp; user profiles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontColor=#1E293B;fontSize=11;align=center;" vertex="1" parent="zone4_box"><mxGeometry as="geometry" x="20" y="45" width="240" height="65" /></mxCell><mxCell id="z4_taai" value="&lt;b&gt;Trimble AI (TAAI) Platform&lt;/b&gt;&lt;br/&gt;• Multimodal Document OCR&lt;br/&gt;• Voice Note Speech-to-Text&lt;br/&gt;• &lt;b&gt;Zero Training on Customer Data&lt;/b&gt;&lt;br/&gt;• Ephemeral In-Memory Processing&lt;br/&gt;• SOC 2 Type II Enterprise Boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#15803D;fontSize=11;align=center;" vertex="1" parent="zone4_box"><mxGeometry as="geometry" x="20" y="130" width="240" height="110" /></mxCell><mxCell id="z4_ps" value="&lt;b&gt;Trimble ProjectSight Cloud API&lt;/b&gt;&lt;br/&gt;• Authoritative System of Record&lt;br/&gt;• Permanent Daily Logs &amp;amp; Hours&lt;br/&gt;• Checklists (Table 189) &amp;amp; Punch&lt;br/&gt;• Enterprise Compliance &amp;amp; Backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#0284C7;strokeWidth=2;fontColor=#0369A1;fontSize=11;align=center;" vertex="1" parent="zone4_box"><mxGeometry as="geometry" x="20" y="260" width="240" height="100" /></mxCell><mxCell id="ze1" value="1. Scoped Intake" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;fontColor=#15803D;fontSize=10;" edge="1" parent="1" source="z1_actor" target="z3_gw"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ze2" value="2. Admin Session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2563EB;fontColor=#1E40AF;fontSize=10;" edge="1" parent="1" source="z2_actor" target="z3_gw"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ze3" value="Validate Session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;fontColor=#1E293B;fontSize=10;dashed=1;" edge="1" parent="1" source="z3_core" target="z4_tid"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ze4" value="3. Secure OCR &amp; Audio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;fontColor=#15803D;fontSize=10;" edge="1" parent="1" source="z3_core" target="z4_taai"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ze5" value="4. Commit Approved SoR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0284C7;fontColor=#0369A1;fontSize=10;" edge="1" parent="1" source="z3_core" target="z4_ps"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="p2_footer" value="&lt;b&gt;Key Enterprise Governance &amp;amp; Privacy Safeguards:&lt;/b&gt;&lt;br/&gt;&lt;b&gt;1. Zero Model Training:&lt;/b&gt; All extraction requests routed through Trimble AI (TAAI) Platform are contractually quarantined. Customer documents, photos, and voice notes are never retained or used to train public or proprietary models.&lt;br/&gt;&lt;b&gt;2. Trade Isolation:&lt;/b&gt; Subcontractor field access is strictly siloed per assigned trade and company. Peer hours, project finances, and superintendent logs are inaccessible.&lt;br/&gt;&lt;b&gt;3. Human-in-the-Loop (HITL):&lt;/b&gt; AI models generate suggested drafts only. No record is committed to ProjectSight without explicit review and approval by Hensel Phelps staff.&lt;br/&gt;&lt;b&gt;4. ProjectSight as System of Record:&lt;/b&gt; Prototype storage is transient. Long-term compliance, historical audit trails, and data preservation reside exclusively in Trimble ProjectSight." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#334155;fontSize=11;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="620" width="1200" height="130" /></mxCell></root></mxGraphModel></diagram><diagram id="ai-extraction-sequence" name="3. AI Extraction Data Flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p3_title" value="&lt;b style='font-size:18px;'&gt;Hensel Phelps &amp;amp; Trimble Field Operations Prototype&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px;color:#475569;'&gt;AI Document Extraction &amp;amp; Human-in-the-Loop Verification Sequence (TAAI Platform)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="200" y="20" width="800" height="45" /></mxCell><mxCell id="ll_hp" value="&lt;b&gt;Hensel Phelps Staff&lt;/b&gt;&lt;br/&gt;(Superintendent / PE)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;strokeWidth=2;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E40AF;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="80" width="180" height="680" /></mxCell><mxCell id="ll_app" value="&lt;b&gt;Field Prototype App&lt;/b&gt;&lt;br/&gt;(hp-trimble-lab.com)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;strokeWidth=2;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry as="geometry" x="390" y="80" width="180" height="680" /></mxCell><mxCell id="ll_taai" value="&lt;b&gt;Trimble AI Platform&lt;/b&gt;&lt;br/&gt;(TAAI Gateway)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;strokeWidth=2;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#15803D;" vertex="1" parent="1"><mxGeometry as="geometry" x="680" y="80" width="180" height="680" /></mxCell><mxCell id="ll_ps" value="&lt;b&gt;Trimble ProjectSight&lt;/b&gt;&lt;br/&gt;(Enterprise Cloud API)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;strokeWidth=2;fillColor=#EFF6FF;strokeColor=#0284C7;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry as="geometry" x="960" y="80" width="180" height="680" /></mxCell><mxCell id="m1_text" value="1. Upload photo of physical checklist or punch sheet" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#1E40AF;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="190" y="160" width="290" height="20" /></mxCell><mxCell id="sm1" value="" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#2563EB;" edge="1" parent="1" source="ll_hp" target="ll_app"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="190" y="185" /><mxPoint x="480" y="185" /></Array></mxGeometry></mxCell><mxCell id="m2_text" value="2. Dispatch image buffer via TLS 1.3 enterprise gateway" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#15803D;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="220" width="290" height="20" /></mxCell><mxCell id="sm2" value="" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#16A34A;" edge="1" parent="1" source="ll_app" target="ll_taai"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="480" y="245" /><mxPoint x="770" y="245" /></Array></mxGeometry></mxCell><mxCell id="taai_act" value="&lt;b&gt;TAAI Ephemeral Execution:&lt;/b&gt;&lt;br/&gt;• Multimodal vision document extraction&lt;br/&gt;• Map rows to ProjectSight checklist schema&lt;br/&gt;• &lt;b&gt;Quarantined in memory — zero model training&lt;/b&gt;&lt;br/&gt;• Audio transcription (Whisper/TAAI TTS)&lt;br/&gt;• Immediate buffer release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="695" y="270" width="240" height="100" /></mxCell><mxCell id="m3_text" value="3. Return structured JSON payload (rows, statuses, remarks)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#15803D;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="390" width="290" height="20" /></mxCell><mxCell id="sm3" value="" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#16A34A;" edge="1" parent="1" source="ll_taai" target="ll_app"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="770" y="415" /><mxPoint x="480" y="415" /></Array></mxGeometry></mxCell><mxCell id="m4_text" value="4. Display side-by-side verification drawer (Original Image vs. Extracted Fields)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#D97706;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="190" y="445" width="290" height="20" /></mxCell><mxCell id="sm4" value="" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#D97706;" edge="1" parent="1" source="ll_app" target="ll_hp"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="480" y="470" /><mxPoint x="190" y="470" /></Array></mxGeometry></mxCell><mxCell id="m5_text" value="5. Human-in-the-Loop: Superintendent reviews, adjusts items, and clicks 'Approve &amp; Commit'" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#2563EB;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="190" y="500" width="290" height="20" /></mxCell><mxCell id="sm5" value="" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#2563EB;" edge="1" parent="1" source="ll_hp" target="ll_app"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="190" y="525" /><mxPoint x="480" y="525" /></Array></mxGeometry></mxCell><mxCell id="m6_text" value="6. Commit verified checklist / daily log to ProjectSight API" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#0284C7;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="560" width="570" height="20" /></mxCell><mxCell id="sm6" value="" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#0284C7;" edge="1" parent="1" source="ll_app" target="ll_ps"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="480" y="585" /><mxPoint x="1050" y="585" /></Array></mxGeometry></mxCell><mxCell id="m7_text" value="7. Return persistent ProjectSight Record ID &amp; timestamp" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#0284C7;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="615" width="570" height="20" /></mxCell><mxCell id="sm7" value="" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#0284C7;" edge="1" parent="1" source="ll_ps" target="ll_app"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1050" y="640" /><mxPoint x="480" y="640" /></Array></mxGeometry></mxCell><mxCell id="m8_text" value="8. Update UI: 'Committed to ProjectSight' badge &amp; audit trail recorded" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;fontColor=#15803D;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="190" y="670" width="290" height="20" /></mxCell><mxCell id="sm8" value="" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeWidth=2;fontSize=11;strokeColor=#15803D;" edge="1" parent="1" source="ll_app" target="ll_hp"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="480" y="695" /><mxPoint x="190" y="695" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>