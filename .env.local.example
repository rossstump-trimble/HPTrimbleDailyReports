# Local UI development — skip Trimble Identity.
# Copy to .env.local:  cp .env.local.example .env.local
#
# localhost / 127.0.0.1 already skip TID even without this file.
# Never set AUTH_MODE=local on the VPN/VM.

AUTH_MODE=local

# Optional: photo-to-daily extraction. The rest of the UI works without it.
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Optional: phone voice intake (speech-to-text). First key found wins:
# GROQ_API_KEY=          # Whisper large-v3 (preferred — fast)
# OPENAI_API_KEY=        # Whisper-1
# GEMINI_API_KEY=        # Gemini audio fallback (same key as photo extract)

# Live ProjectSight Daily Report create (VM / TID only).
# PROJECTSIGHT_API_BASE_URL=https://us-east.api.trimble.com/projectsightapi/us1/v1
# PROJECTSIGHT_AUTH_HEADER=Authorization
