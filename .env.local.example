# Local UI development — skip Trimble Identity.
# Copy to .env.local:  cp .env.local.example .env.local
#
# localhost / 127.0.0.1 already skip TID even without this file.
# Never set AUTH_MODE=local on the VPN/VM.

AUTH_MODE=local

# Optional on localhost. On the GCE VM, Gemini uses Vertex ADC instead
# (same service account as the FastAPI caption client).
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GCP_PROJECT=nextgenscheduling
# GCP_LOCATION=global
# GCP_TTS_LOCATION=us-central1
# VERTEX_MODEL=gemini-3.7-flash
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore

# Optional: faster Whisper STT. Vertex Gemini transcribes if these are unset.
# GROQ_API_KEY=          # Whisper large-v3
# OPENAI_API_KEY=        # Whisper-1

# Live ProjectSight Daily Report create (VM / TID only).
# PROJECTSIGHT_API_BASE_URL=https://us-east.api.trimble.com/projectsightapi/us1/v1
# PROJECTSIGHT_AUTH_HEADER=Authorization
